KAFKA_TOPIC=e-commerce-data
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
CSV_PATH=data/input/E-Commerce Data.csv
OUTPUT_PATH=data/output/lab1/parquet
CHECKPOINT_PATH=data/output/lab1/checkpoints/kafka_to_parquet

LAB2_KAFKA_TOPIC=e-commerce-data-lab2
LAB2_PRODUCER_BOOTSTRAP_SERVERS=localhost:9092
LAB2_FLINK_BOOTSTRAP_SERVERS=kafka:29092
LAB2_OUTPUT_PATH=file:///workspace/data/output/lab2/parquet
LAB2_CHECKPOINT_PATH=file:///workspace/data/output/lab2/checkpoints
LAB2_SAVEPOINT_PATH=file:///workspace/data/output/lab2/savepoints
LAB2_VERIFY_OUTPUT_PATH=data/output/lab2/parquet
KAFKA_GROUP_ID=flink-lab2
FLINK_CHECKPOINT_INTERVAL_MS=5000
FLINK_PIPELINE_NAME=lab2-kafka-to-parquet_1
FLINK_MAP_DELAY_MS=0

LAB3_KAFKA_TOPIC=e-commerce-data-lab3
LAB3_PRODUCER_BOOTSTRAP_SERVERS=localhost:9092
LAB3_FLINK_BOOTSTRAP_SERVERS=kafka:29092
LAB3_KAFKA_GROUP_ID=flink-lab3
LAB3_FLINK_PIPELINE_NAME=lab3-event-time-window-count
LAB3_WINDOW_SIZE_SEC=10
LAB3_WATERMARK_OUT_OF_ORDER_SEC=5
LAB3_ALLOWED_LATENESS_SEC=10
LAB3_EVENTS_COUNT=200
LAB3_SEND_INTERVAL_MS=100
LAB3_RANDOM_SEED=42
LAB3_OUT_OF_ORDER_RATIO=0.25
LAB3_LATE_RATIO=0.15
LAB3_LATE_SHIFT_MIN_SEC=20
LAB3_LATE_SHIFT_MAX_SEC=45
LAB3_DELAY_RELEASE_MIN_EVENTS=5
LAB3_DELAY_RELEASE_MAX_EVENTS=12

LAB4_EVENTS_TOPIC=e-commerce-events-lab4
LAB4_RULES_TOPIC=e-commerce-rules-lab4
LAB4_PRODUCER_BOOTSTRAP_SERVERS=localhost:9092
LAB4_FLINK_BOOTSTRAP_SERVERS=kafka:29092
LAB4_EVENTS_GROUP_ID=flink-lab4-events
LAB4_RULES_GROUP_ID=flink-lab4-rules
LAB4_FLINK_PIPELINE_NAME=lab4-keyed-user-stats
LAB4_EVENTS_COUNT=500
LAB4_SEND_INTERVAL_MS=150
LAB4_RULE_FREQUENCY_EVENTS=25
LAB4_RANDOM_SEED=42
